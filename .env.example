# GEMINI_API_KEY: Required for Gemini AI meal text and image analysis.
# In AI Studio, configure via Settings -> Secrets; on Render, set in Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model ID used for meal text and food image analysis.
GEMINI_MODEL="gemini-4-hydrogen"

# GEMINI_FALLBACK_MODELS: Optional comma-separated model IDs tried after retryable primary-model errors.
GEMINI_FALLBACK_MODELS="gemini-4-hydrogen, gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3-flash-preview, gemini-2.5-flash, gemini-2.5-flash-lite, gemma-4-31b-it, gemma-4-26b-a4b-it, gemini-3.8-flash-tts, gemini-3.8-flash-lite-tts, gemini-3.1-flash-tts-preview, gemini-2.5-flash-tts, gemini-3.5-transcribe, gemini-3.8-live, gemini-3.8-live-extended-thinking, gemini-3.1-flash-live-preview, gemini-3.5-live-translate-preview, gemini-3.5-transcribe-live, gemini-2.5-flash-native-audio-dialog, gemini-embedding-002, gemini-embedding-001, gemini-decision-1, gemini-robotics-er-2-preview, lyria-realtime"

# GEMINI_USE_SEARCH: Enable Google Search grounding only when set to exactly "true" (disabled by default).
GEMINI_USE_SEARCH="true"

# SUPABASE_URL: Your Supabase project URL (Settings -> API -> Project URL).
# Also accepts VITE_SUPABASE_URL if configured at build time.
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Client-safe Supabase publishable/anon key (Settings -> API -> Project API keys).
# Also accepts SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase service role key (Settings -> API -> service_role).
# Keep this secret on the server only (configure in Render Environment Variables / AI Studio Secrets).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# DATABASE_PROVIDER: "supabase" (default when SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY are set) or "memory".
DATABASE_PROVIDER="supabase"

# APP_URL: Public URL where KainLab is hosted (e.g. https://kainlab.onrender.com).
APP_URL="MY_APP_URL"

# PORT: HTTP server port (defaults to 3000; Render sets this automatically).
PORT="3000"
