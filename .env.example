# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model ID used for meal text and food image analysis.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted (e.g. https://your-app.onrender.com).
APP_URL="MY_APP_URL"

# DATABASE_PROVIDER: Set to "supabase" when deploying with Supabase PostgreSQL.
# Defaults to "supabase" automatically when SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided.
DATABASE_PROVIDER="supabase"

# SUPABASE_URL: Your Supabase project URL (Settings -> API -> Project URL).
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Client-safe Supabase publishable/anon key (Settings -> API -> Project API keys).
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase service role key (Settings -> API -> service_role).
# Keep this secret on the server only (configure in Render Environment Variables).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
