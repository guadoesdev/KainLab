{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public-safe user profile and daily calorie goal linked to Firebase Auth UID (excludes PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth user UID."
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Canonical lowercase handle chosen by the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "User's display name."
        },
        "dailyCalorieGoal": {
          "type": "number",
          "description": "Target daily calorie intake in kcal (800-10000)."
        },
        "proteinGoal": {
          "type": "number",
          "description": "Target daily protein intake in grams (20-500)."
        },
        "carbsGoal": {
          "type": "number",
          "description": "Target daily carbohydrate intake in grams (20-1000)."
        },
        "fatGoal": {
          "type": "number",
          "description": "Target daily fat intake in grams (10-400)."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL from OAuth provider."
        },
        "provider": {
          "type": "string",
          "enum": ["google.com", "password"],
          "description": "Primary authentication provider used."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "username", "displayName", "dailyCalorieGoal", "provider", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing user email address, readable only by the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "UsernameHandle": {
      "title": "UsernameHandle",
      "description": "Unique username reservation document containing no PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "MealEntry": {
      "title": "MealEntry",
      "description": "Logged daily meal entry with immutable source/confidence and validated nutrition macros.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "mealType": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        },
        "foods": {
          "type": "array",
          "description": "List of food item names (1-20 items)."
        },
        "portions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "confidence": { "type": "number" },
        "source": {
          "type": "string",
          "enum": ["text", "image"]
        },
        "sources": {
          "type": "array",
          "description": "Optional nutrition research source URLs (max 5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "dateKey", "mealType", "foods", "portions", "calories", "protein", "carbs", "fat", "confidence", "source", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Persistent AI Nutrition Assistant chat message for a given day.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mealId": {
          "type": "string",
          "maxLength": 128
        },
        "confidence": {
          "type": "number"
        },
        "clarificationOptions": {
          "type": "array"
        },
        "sources": {
          "type": "array"
        },
        "nutritionSnapshot": {
          "type": "object"
        },
        "hasImage": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "dateKey", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-scoped user profile and daily calorie goal without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII subcollection (contact document)."
    },
    "/users/{userId}/meals/{mealId}": {
      "schema": { "$ref": "#/entities/MealEntry" },
      "description": "Owner-scoped logged meal entries."
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Owner-scoped persistent AI Nutrition Assistant chat messages."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameHandle" },
      "description": "Unique username reservation registry."
    }
  }
}
